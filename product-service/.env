# .env

# This is the connection string for the main container Database URL
DATABASE_URL=postgresql://Shayankhan:mysecretpassword@product-service-db:5432/service-db

# This is the connection string for the test branch of Neon Database URL
TEST_DATABASE_URL=postgresql://Shayandb_owner:VjURFkui4AE5@ep-dry-unit-a1kc7xp6.ap-southeast-1.aws.neon.tech/service-db?sslmode=require

# Kafka Bootstrap Server
BOOTSTRAP_SERVER=broker:19092

#TOPIC For PRODUCT
KAFKA_PRODUCT_TOPIC=Product-events
#TOPIC For PRODUCT Validation
KAFKA_PRODUCT_REQUEST_TOPIC=Product-request
KAFKA_PRODUCT_RESPONSE_TOPIC=Product-response
#CONSUMER GRPOUP For PRODUCT
KAFKA_CONSUMER_GROUP_ID_FOR_PRODUCT="Product"
#CONSUMER GRPOUP For PRODUCT Validation
KAFKA_CONSUMER_GROUP_ID_FOR_PRODUCT_VALIDATION="Product-request-group"


#TOPIC For ORDER
KAFKA_ORDER_TOPIC=Order-events
#TOPIC For ORDER Validation
KAFKA_ORDER_REQUEST_TOPIC=Order-request
KAFKA_ORDER_RESPONSE_TOPIC=Order-response
#CONSIUMER GRPOUP For ORDER
KAFKA_CONSUMER_GROUP_ID_FOR_ORDER="Order"
#CONSUMER GRPOUP For ORDER Validation
KAFKA_CONSUMER_GROUP_ID_FOR_ORDER_VALIDATION="Order-request-group"